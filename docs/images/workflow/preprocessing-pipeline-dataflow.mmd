flowchart TB
  classDef input fill:#eff8ff,stroke:#2e90fa,stroke-width:1.5px,color:#101828
  classDef stage fill:#f8fafc,stroke:#667085,stroke-width:1.5px,color:#101828
  classDef optional fill:#fff7ed,stroke:#f79009,stroke-width:1.5px,color:#101828
  classDef output fill:#ecfdf3,stroke:#12b76a,stroke-width:1.5px,color:#101828
  classDef review fill:#fdf2fa,stroke:#c11574,stroke-width:1.5px,color:#101828

  raw["<b>Inputs</b><br/>Raw session directory<br/>TIFF/OME-TIFF movies, voltage CSV, optional Bpod .mat"]
  launch["<b>Job generation</b><br/><code>python -m utils_2p.processing_pipeline submit|generate</code><br/>Writes <code>manifest.json</code>, stage <code>.sbatch</code> files, <code>submit_jobs.sh</code>, and logs"]

  prep["<b>1. Prep</b><br/><code>run_stage(..., stage='prep')</code><br/><code>_run_prep(data, session)</code><br/>Creates <code>raw_voltages.h5</code>, copies <code>bpod_session_data.mat</code>, writes provenance JSON"]

  suite2p["<b>2. Suite2p</b><br/><code>run_stage(..., stage='suite2p')</code><br/><code>_run_suite2p(data, session)</code><br/><code>suite2p.run_s2p(ops=ops, db=db)</code><br/>Writes <code>suite2p/plane0/ops.npy</code>, <code>stat.npy</code>, <code>F.npy</code>, <code>Fneu.npy</code>, <code>iscell.npy</code>, <code>spks.npy</code>"]

  dff["<b>3. dF/F</b><br/><code>run_stage(..., stage='dff')</code><br/><code>_run_dff(data, session)</code><br/><code>dff_traces.run(ops, normalize=False, correct_pmt=False)</code><br/>Reads native <code>suite2p/plane0/F.npy</code> and <code>Fneu.npy</code>; writes <code>dff.h5</code>"]

  summary["<b>4. Summary and interactive reviewer</b><br/><code>run_stage(..., stage='summary')</code><br/><code>_run_summary(data, session)</code><br/><code>create_processing_summary(session['output_path'], input_layout='suite2p')</code><br/>Writes the processing PDF and interactive ROI reviewer HTML"]

  exports["<b>Reviewer exports and downstream use</b><br/><code>roi_manual_labels.npy</code>, QC threshold JSON, ROI metric CSV<br/>Downstream analysis applies ROI-indexed label/filter masks"]

  roiModel["<b>ROI model scores</b><br/><i>optional: <code>--run-roi-model-scores</code></i><br/><code>_run_roi_model_scores(data, session)</code><br/><code>roi_model_scores.run(session['output_path'], model_path=...)</code><br/>Currently only for cerebellar dendrite ROIs<br/>Writes <code>roi_model_scores.h5</code>; may update <code>ROI_label.h5</code>"]

  label["<b>Cell-type label</b><br/><i>optional: <code>--run-label</code></i><br/><code>_run_label(data, session)</code><br/><code>LabelExcInh.run(ops, diameter=6)</code><br/>Writes <code>masks.h5</code>"]

  spikes["<b>Inferred spikes</b><br/><i>optional: <code>--run-oasis</code></i><br/><code>_run_spikes(data, session)</code><br/><code>oasis_spikes.run(ops, tau=oasis_tau, event_threshold=...)</code><br/>Writes <code>spikes.h5</code>"]

  raw --> launch --> prep --> suite2p --> dff --> summary --> exports
  suite2p -. "optional model scoring" .-> roiModel
  suite2p -. "optional anatomical labeling" .-> label
  dff -. "optional OASIS" .-> spikes
  roiModel -. "metrics / optional initial labels" .-> summary
  label -. "cell-type labels" .-> summary
  spikes -. "inferred-spike metrics" .-> summary

  class raw,launch input
  class prep,suite2p,dff stage
  class summary review
  class exports output
  class roiModel,label,spikes optional
