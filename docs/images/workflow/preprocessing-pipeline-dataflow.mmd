  s2p_out --> qc_fn
  qc_fn --> qc_metrics
  qc_metrics --> qc_out
  s2p_out --> qc_out
  s2p_out --> roi_qc_fn
  roi_qc_model --> roi_qc_fn
  roi_qc_fn --> roi_qc_out
  roi_qc_fn --> roi_label_h5
  qc_out --> cellpose
  s2p_out --> cellpose
  cellpose --> overlap
  overlap --> masks_h5
  qc_out --> dff_fn
  s2p_out --> dff_fn
  dff_fn --> dff_out
  dff_out --> oasis
  s2p_out --> oasis
  oasis --> spike_out
  s2p_out --> summary_fn
  qc_out --> summary_fn
  roi_qc_out --> summary_fn
  roi_label_h5 --> summary_fn
  masks_h5 --> summary_fn
  dff_out --> summary_fn
  spike_out --> summary_fn
  summary_fn --> metrics
  metrics --> html
  summary_fn --> pdf
  summary_fn --> sidecars
  html --> labels
  html --> spreadsheet
  html --> filters
  labels --> analysis
  spreadsheet --> analysis
  filters --> analysis
  s2p_out --> analysis
